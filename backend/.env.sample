# backend/.env として配置する。.env はコミットしないこと。

# ── 実行環境 ──
# local のときだけ Google ログインを省略する。**未設定は production 扱い**。
# ここに local と書いてよいのは、この .env（ローカル）だけ。compose.yaml には書かないこと。
#   - クラウド上で local のままだと、アプリが起動を拒否する
#   - 有効な間は画面上部に常時バナーが出る
APP_ENV=local

# 開発時に「ログインしている人」として扱うユーザー。APP_ENV=local のときだけ有効。
# このメールのユーザーがユーザーマスターにいれば、そのロールと所属グループで動く。
DEV_USER_EMAIL=dev@example.com
DEV_USER_NAME=開発ユーザー
# admin / device_admin / power / user。**user に切り替えて確認すること**（admin だと全部見えてしまう）
DEV_USER_ROLE=admin

# ── ログイン（本番）──
# セッション Cookie の署名鍵。本番では必須。変えると全員ログアウトになる。
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SESSION_SECRET=
# Google OAuth のウェブクライアント ID。「承認済みの JavaScript 生成元」に、開く URL を完全一致で登録する
GOOGLE_OAUTH_CLIENT_ID=
# 起動時に管理者として登録する人（カンマ区切り）。最初の 1 人を入れるため
BOOTSTRAP_ADMIN_EMAILS=

# https で配信するときは true（Cookie を https でだけ送る）
SESSION_HTTPS_ONLY=false

# ── 開発用サーバー ──
# uv run python main.py で起動するときのポート
PORT=8080

# ── 保存先 ──
# SQLite（と、rustfs を使わないときの画像）を置くディレクトリ。コンテナではボリュームをマウントする。
DATA_DIR=./data

# ── 画像の置き場（rustfs / S3 互換）──
# 設定すると画像とサムネイルを rustfs に置く。空なら DATA_DIR の下に置く。
# 開発時は docker compose --profile dev up -d rustfs で起動し、キーはルートの .env の RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY と同じにする
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kazayomi
S3_REGION=us-east-1

# ── Ayame ──
# シグナリングサーバは環境変数ではなく、マスター › サーバで登録して「既定のサーバ」を決める
# Ayame の認証 Webhook（/api/ayame/authn）を呼んでよい接続元（IP か CIDR）。既定は 127.0.0.1 と ::1。
# プロキシを通った呼び出し（X-Forwarded-For などが付いたもの）は、接続元に関わらず断る。
# Linux の Docker で開発するときは 172.16.0.0/12 を足す（Docker Desktop の Mac では不要）
AYAME_WEBHOOK_ALLOWED_IPS=127.0.0.1,::1
# 追加で ?key=<この値> の一致も求めるときだけ設定する（任意）
AYAME_WEBHOOK_SECRET=

# ── Valkey ──
# 撮像トークンの置き場。未設定ならプロセス内のメモリを使う（worker 1 つの開発時のみ）。
# 例: valkey://localhost:6379/0
VALKEY_URL=
CAPTURE_TOKEN_TTL_SECONDS=60

# ── 画像 ──
MAX_UPLOAD_BYTES=31457280
THUMBNAIL_SIZE=320

# ── CORS ──
# ブラウザから叩く Origin をカンマ区切りで列挙する。* は使わない。
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:5173
