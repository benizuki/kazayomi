# compose.yaml と同じ場所に .env として置く（docker compose が読む）。.env はコミットしないこと。
# ローカルで動かす場合は、APP_ENV localを設定する。
APP_ENV=local

# セッション Cookie の署名鍵（必須）
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SESSION_SECRET=

# Google OAuth のウェブクライアント ID
GOOGLE_OAUTH_CLIENT_ID=

# 最初の管理者（カンマ区切り）
BOOTSTRAP_ADMIN_EMAILS=

# 画像の置き場（rustfs）のアクセスキー。どちらも長いランダムな文字列にする
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
