# compose.yaml と同じ場所に .env として置く（docker compose が読む）。.env はコミットしないこと。
# 手順は docs/guide.md の「手元で試す」「Google ログインで動かす」を参照。

# ── 手元で試す（http://<この PC の IP>:8080 で開く）──
# http で IP を開くときは Google ログインを使えないので、APP_ENV=local でログインを省く。
# 開いた人は誰でも管理者になるので、自分の PC の中か信頼できるネットワークの中だけで使う。
# Google ログインで動かすときは、この行を消す。
APP_ENV=local
# iPhone から開ける kazayomi の URL（例: http://192.168.1.10:8080）。登録 QR に入る。
# 初めて起動したときに、このホストの 3000 番の Ayame を既定のサーバにして、ルームとデバイスを 1 つずつ作る
PUBLIC_BASE_URL=

# セッション Cookie の署名鍵（必須）
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SESSION_SECRET=

# ── Google ログインで動かす（https で開けるドメインが要る）──
# Google OAuth のウェブクライアント ID
GOOGLE_OAUTH_CLIENT_ID=
# 最初の管理者（カンマ区切り）
BOOTSTRAP_ADMIN_EMAILS=
# https で配信するので true
#SESSION_HTTPS_ONLY=true

# 画像の置き場（rustfs）のアクセスキー。どちらも長いランダムな文字列にする
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
